# Server-only credentials. Never commit .env or paste keys into chat.
GEOAPIFY_API_KEY=
# Optional Kroger provider; leave blank while registration is blocked.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Optional natural-language parsing; structured forms do not require an LLM.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
