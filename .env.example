# Server-only credentials. Never commit .env or paste keys into chat.
GEOAPIFY_API_KEY=
# Current branch prices/stock: create a Kroger developer application.
# See docs/CURRENT_PRICES.md; leave blank to use historical evidence only.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Optional natural-language parsing; structured forms do not require an LLM.
# api: uses the three settings below. codex: LOCAL demo only, uses codex login.
LLM_BACKEND=api
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Optional reminder email (see docs/NOTIFICATIONS.md). Use an app password, not your normal one.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
